# Copy this file to .env and fill in real values. Never commit .env.

# --- Firebase Admin SDK (server-side, SECRET) ---
# Firebase Console > Project Settings > Service Accounts > Generate new private key.
# The downloaded JSON contains project_id, client_email and private_key.
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-firebase-project-id.iam.gserviceaccount.com
# In THIS file: paste the key on one line, keep the literal \n escapes from the
# JSON file, and wrap it in double quotes.
# In a hosting dashboard: paste the key WITHOUT the quotes. Platforms differ on
# what they do to the line breaks - some fold them into spaces - so
# normalizePrivateKey() in src/lib/firebaseAdmin.ts rebuilds the PEM either way.
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"

# --- Firebase Web SDK (shipped to the browser, not secret) ---
# Firebase Console > Project Settings > General > Your apps > Web app config.
NEXT_PUBLIC_FIREBASE_API_KEY=your-web-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-firebase-project-id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-firebase-project-id

# --- Deployment ---
# Sub-path the app is served from, e.g. /scuderia when hosted on GitHub Pages.
# Leave unset for local development.
# PAGES_BASE_PATH=
